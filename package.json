{
  "name": "mini-restate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny local-only durable workflow runtime backed by SQLite",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "bin": {
    "mini-restate": "./dist/bin/mini-restate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "mini-restate": "node ./bin/mini-restate.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
