{
  "name": "@jugyo/duex",
  "version": "0.1.0",
  "type": "module",
  "description": "A small durable execution runtime for TypeScript, backed by SQLite",
  "license": "MIT",
  "author": "Kaz <kkohno@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugyo/duex.git"
  },
  "bugs": {
    "url": "https://github.com/jugyo/duex/issues"
  },
  "homepage": "https://github.com/jugyo/duex#readme",
  "keywords": [
    "workflow",
    "durable",
    "durable-execution",
    "sqlite",
    "local"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "duex": "dist/bin/duex.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "duex": "node ./bin/duex.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
